# ─── Telegram ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_ADMIN_CHAT_ID=your_personal_chat_id

# ─── Anthropic (Claude) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optionnel : modèle / effort Claude (défaut : claude-sonnet-5-5, low / medium).
# Permet de changer de modèle sur Railway sans modifier le code.
# MODEL_FLASH=claude-sonnet-5-5
# MODEL_RICH=claude-sonnet-5-5
# EFFORT_FLASH=low
# EFFORT_RICH=medium
# EFFORT_SELECT=low      # choix de l'article
# EFFORT_CHECK=high      # relecture factuelle (prix, caractéristiques)

# ─── Bot Config ────────────────────────────────────────
TIMEZONE=Europe/Paris
SEND_ON_START=false
# Base SQLite. Sur Railway le disque est éphémère : attachez un volume au
# service (ex. point de montage /data) et le bot y placera automatiquement
# la base ; sans volume, l'historique est effacé à chaque déploiement.
DB_PATH=watchpoint.db

# ─── Optional API Keys (for scrapers) ──────────────────
# WATCHSIGNALS_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# FRED_API_KEY=
# XE_API_KEY=
# EBAY_APP_ID=
